FROM rust:1.85.1-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS builder

WORKDIR /source
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY benchmarks/ocpq/strict_candidate_benchmark.rs ./benchmarks/ocpq/strict_candidate_benchmark.rs
COPY benchmarks/ocpq/strict_resource_support.rs ./benchmarks/ocpq/strict_resource_support.rs
RUN cargo build --release --locked --package ocpm-postgres --example ocpq_candidate_benchmark

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ARG SOURCE_REVISION=unknown

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /benchmark /output
COPY --from=builder /source/target/release/examples/ocpq_candidate_benchmark \
    /usr/local/bin/ocpq_candidate_benchmark
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}"

WORKDIR /benchmark
ENTRYPOINT ["/usr/local/bin/ocpq_candidate_benchmark"]
