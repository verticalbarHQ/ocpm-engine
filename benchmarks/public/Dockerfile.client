FROM rust:1.85-bookworm@sha256:e51d0265072d2d9d5d320f6a44dde6b9ef13653b035098febd68cce8fa7c0bc4 AS builder

ARG TARGETARCH
ARG DUCKDB_VERSION=1.5.5
ARG DUCKDB_ARM64_SHA256=abe4f6f005ee0b448a058322f4263584b4bd1b6faf7ab4637b79eeaf978f8e9c
ARG DUCKDB_AMD64_SHA256=1fb8ce388157d84a25abe685a8a2520bf00c00321821968e4bb398fd766e7abb
ARG DUCKDB_ARM64_HTTPFS_SHA256=0820e0b5b74efaa23608c239df8e744a68943318d530b483a529eace19cb5475
ARG DUCKDB_ARM64_AWS_SHA256=c0c2ff813d07a1f69a3c06fb69663b93299f1145dbaab9aaeee1be4003da7170
ARG DUCKDB_AMD64_HTTPFS_SHA256=7cdd52a3135388718884a9b71e3987ba723002121e8e9de399c4ed619d824a05
ARG DUCKDB_AMD64_AWS_SHA256=7454a7830b21e678f1700c6cc428540be3a688e959c81515fd1bfc0a538db3b3

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl unzip python3-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Link to the official, checksum-pinned shared client library. DuckDB is not
# compiled into ocpm-engine and remains replaceable at the deployment boundary.
RUN case "${TARGETARCH}" in \
      arm64) archive=libduckdb-linux-arm64.zip; platform=linux_arm64; expected="${DUCKDB_ARM64_SHA256}"; httpfs_expected="${DUCKDB_ARM64_HTTPFS_SHA256}"; aws_expected="${DUCKDB_ARM64_AWS_SHA256}" ;; \
      amd64) archive=libduckdb-linux-amd64.zip; platform=linux_amd64; expected="${DUCKDB_AMD64_SHA256}"; httpfs_expected="${DUCKDB_AMD64_HTTPFS_SHA256}"; aws_expected="${DUCKDB_AMD64_AWS_SHA256}" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 2 ;; \
    esac \
    && curl -fsSL -o /tmp/libduckdb.zip \
      "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/${archive}" \
    && echo "${expected}  /tmp/libduckdb.zip" | sha256sum --check --strict \
    && mkdir -p /opt/duckdb \
    && unzip -q /tmp/libduckdb.zip libduckdb.so duckdb.h -d /opt/duckdb \
    && extension_dir="/opt/duckdb/extensions/v${DUCKDB_VERSION}/${platform}" \
    && mkdir -p "${extension_dir}" \
    && for extension in httpfs aws; do \
      case "${extension}" in httpfs) extension_expected="${httpfs_expected}" ;; aws) extension_expected="${aws_expected}" ;; esac; \
      curl -fsSL -o "/tmp/${extension}.duckdb_extension.gz" \
        "https://extensions.duckdb.org/v${DUCKDB_VERSION}/${platform}/${extension}.duckdb_extension.gz"; \
      echo "${extension_expected}  /tmp/${extension}.duckdb_extension.gz" | sha256sum --check --strict; \
      gzip -dc "/tmp/${extension}.duckdb_extension.gz" > "${extension_dir}/${extension}.duckdb_extension"; \
    done \
    && rm /tmp/libduckdb.zip /tmp/*.duckdb_extension.gz

ENV DUCKDB_LIB_DIR=/opt/duckdb \
    DUCKDB_INCLUDE_DIR=/opt/duckdb

WORKDIR /source
COPY --from=engine_source . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/source/target \
    python3 -m venv /build-venv \
    && /build-venv/bin/pip install --no-cache-dir 'maturin==1.9.6' \
    && /build-venv/bin/maturin build --release --locked \
      --compatibility linux --auditwheel skip --out /wheels

FROM python:3.11-slim-bookworm@sha256:b18992999dbe963a45a8a4da40ac2b1975be1a776d939d098c647482bcad5cba

ARG CONTROLLER_REVISION=unknown
ARG ENGINE_REVISION=unknown

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY benchmarks/public/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --require-hashes \
      --requirement /tmp/requirements.lock
COPY --from=builder /wheels /wheels
COPY --from=builder /opt/duckdb/libduckdb.so /usr/local/lib/libduckdb.so
COPY --from=builder /opt/duckdb/extensions /root/.duckdb/extensions
RUN pip install --no-cache-dir /wheels/*.whl \
    && rm -rf /wheels \
    && ldconfig

WORKDIR /workspace
COPY benchmarks ./benchmarks
LABEL org.opencontainers.image.revision="${CONTROLLER_REVISION}" \
      org.opencontainers.image.ocpm-engine.revision="${ENGINE_REVISION}"
CMD ["sleep", "infinity"]
